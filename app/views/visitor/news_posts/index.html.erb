<% title "News" %>
<% liquid_args = add_common_liquid_args %>
<% liquid_args['posts'] = @news_posts.map(&:to_liquid) %>

<% template = Liquid::Template.parse(@site.site_theme.show_news_posts_template.template) %>
<%= raw template.render(liquid_args, filters: [LiquidFilters]) %>

<% content_for :css do %>
  <% template = Liquid::Template.parse( @site.site_theme.show_news_posts_template.css) %>
  <%= raw template.render(liquid_args, filters: [LiquidFilters]) %>
<% end %>
