<% title "#{@item.title}" %>

<% liquid_args = add_common_liquid_args %>
<% liquid_args['item'] = @item %>
<% liquid_args['photos'] = render(:file => 'visitor/items/_photos.html.erb').html_safe %>
<% liquid_args['next_prev_links'] = render(:file => 'visitor/items/_next_prev_links.html.erb').html_safe %>

<% template = Liquid::Template.parse(@site.site_theme.show_artifact_template.template) %>
<%= raw template.render(liquid_args, filters: [LiquidFilters]) %>

<% content_for :css do %>
  <% template = Liquid::Template.parse( @site.site_theme.show_artifact_template.css) %>
  <%= raw template.render(liquid_args, filters: [LiquidFilters]) %>
<% end %>
