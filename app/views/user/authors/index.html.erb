<% title "Authors" %>
<div id="shown_content">
  <h2>Authors</h2>
  <table>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>&nbsp;</th>
      <th>&nbsp;</th>
    </tr>
    <% for author in @authors %>
      <tr>
        <td><%= sanitize author.name %></td>
        <td><%= sanitize author.description %></td>
        <td><%= link_to "Edit", edit_admin_author_path(@site.id, author) %></td>
        <td><%= link_to "Destroy", admin_author_path(@site.id, author), :confirm => 'Are you sure?', :method => :delete %></td>
      </tr>
    <% end %>
  </table>

  <p><%= link_to "Add Author", new_admin_author_path(@site.id) %></p>
</div>