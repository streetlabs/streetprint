<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN"
  "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html>
  <head>
    <title>Streetprint<%= (yield(:title)) %></title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <%= stylesheet_link_tag '/stylesheets/application.css', '/stylesheets/new.css', '/stylesheets/admin.css', '/stylesheets/static.css' %>
    <%= javascript_include_tag '/javascripts/jquery.js', '/javascripts/jquery_ujs.js', '/javascripts/application.js', '/javascripts/narratives.js' %>
    <%= yield(:head) %>
  </head>
  <body>
    <% if !@site || @site.id==nil %>
      <div id="admin-header"><%= link_to "STREETPRINT 5.0 BETA", root_path %></div>
    <% else %>
        <div id="admin-header"><%= link_to "STREETPRINT 5.0 BETA", root_path %> | <%= link_to @site.name, site_path(@site) %> </div>
    <% end %>
    <div id="nav-header">
      <% if !current_user %>
        <%= link_to "Sign Up", new_account_path %> |
        <%= link_to "Log In", login_path %> |
        <%= link_to "Forgot Password", new_password_reset_path %>
      <% else %>
        <%= link_to "Home", admin_path %> |
        <%= link_to "My Account", account_path %> |
        <%= link_to "Logout", logout_path, :method => :delete %>
      <% end %>
    </div>
    <div id="flash">
      <%- flash.each do |name, msg| -%>
        <%= content_tag :div, msg, :id => "flash_#{name}" %>
      <%- end -%>
    </div>
    <div id="breadcrumb"><%= breadcrumbs separator: " &rsaquo; " %></div>
    <div id="container">

      <%= yield %>
      <br style="clear: both;"/>
    </div>
    <div id="footer">
      <%= link_to image_tag("/images/sp_org.png", :border=>0), "http://www.streetprint.org" %><br /><br />
      &copy; CRCSTUDIO 2009. All rights reserved.
    </div>
  </body>
</html>
